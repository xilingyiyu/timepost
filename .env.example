# ============ 应用配置 ============
APP_NAME=时光邮局
APP_URL=http://localhost:8080
APP_DEBUG=true

# ============ JWT ============
# 生成命令: php -r 'echo bin2hex(random_bytes(32));'
JWT_SECRET=change-me-please
JWT_TTL=604800

# ============ 本地文件存储 ============
# 附件上传目录（绝对路径，需 PHP 有写权限）
STORAGE_LOCAL_PATH=/var/www/timepost/storage/uploads

# ============ 彩虹聚合登录 (u.arsn.cn) ============
# 请到 https://u.arsn.cn 申请 AppID / AppKey
CAIHONG_API_BASE=https://u.arsn.cn/connect.php
CAIHONG_APPID=
CAIHONG_APPKEY=
CAIHONG_REDIRECT_URI=http://你的域名/api/auth/oauth/callback

# ============ 短信（阿里云）============
SMS_PROVIDER=aliyun
SMS_ACCESS_KEY=
SMS_SECRET_KEY=
SMS_SIGN=时光邮局
SMS_TEMPLATE_CODE=

# ============ 邮件（SMTP）============
MAIL_HOST=smtp.qq.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=时光邮局

# ============ 运维告警 ============
ALERT_EMAIL=
BACKUP_RETENTION_DAYS=30

# ============ 附件限制 ============
# 图片 ≤20MB，视频 ≤1GB（后端自动判断）
ATTACHMENT_MAX_COUNT=9
ATTACHMENT_ALLOW_EXT=jpg,jpeg,png,gif,webp,mp4,mov,avi,webm
